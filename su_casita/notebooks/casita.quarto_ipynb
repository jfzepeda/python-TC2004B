        "\n",
        "## Fase I : Entendimiento del negocio \n",
        "\n",
        "🎯 **Objetivo** : Estimar precios de viviendas de Sacramento. \n",
        "\n",
        "![](../figures/vivienda.jpeg){fig-align ='center' width = \"300\"}\n",
        "\n",
        "## Fase 2: Entendimiento de los datos"
      ],
      "id": "d8c53adf"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns"
      ],
      "id": "43056ca3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Cargar el dataset\n",
        "data = pd.read_csv('/Users/juanpablo/Developer/Ciencia de Datos/su_casita/data/sacramento.csv')\n",
        "data.head()"
      ],
      "id": "e0cc7d53",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "```{python}# Información general del dataset\n",
        "data.info()\n",
        "```"
      ],
      "id": "c6ff6e91"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "data['type'].value_counts(normalize=True)"
      ],
      "id": "f79249d3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "pd.crosstab(data['zip'], data['type'])"
      ],
      "id": "21585d1b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "data.describe()"
      ],
      "id": "44a98d4f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "%run ../scripts/funciones.py\n",
        "\n",
        "help(create_train_test)"
      ],
      "id": "5f29f4e7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "train_set, test_set = create_train_test(data, test_ratio=0.3, seed=42)\n",
        "train_set.head()\n",
        "test_set.head()"
      ],
      "id": "0f6d13c3",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "train_set, test_set = train_test_split(data, test_size=0.3, random_state=42)\n",
        "\n",
        "train_set.head()\n",
        "test_set.head()"
      ],
      "id": "0e9f845d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "sns.histplot(data, x='price')\n",
        "plt.show()"
      ],
      "id": "ffc0a16a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "price_cuts = np.quantile(data['price'], [0.2, 0.4, 0.6, 0.8])"
      ],
      "id": "6775ed48",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "data['price_cat'] = pd.cut(data['price'], bins=[-np.inf,price_cuts[0], price_cuts[1], price_cuts[2], price_cuts[3], np.inf], labels=[1, 2, 3, 4, 5])"
      ],
      "id": "9b0ca62c",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "data[\"price_cat\"].value_counts(normalize = True).sort_index().plot.bar(rot = 0, color = \"dodgerblue\")\n",
        "plt.xlabel(\"Categoría de precio\")\n",
        "plt.ylabel(\"Proporción\")\n",
        "plt.title(\"Bar chart del precio discretizado\")\n",
        "plt.show()"
      ],
      "id": "690fc55b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "strat_train, strat_test = train_test_split(data, test_size = 0.3, stratify = data['price_cat'], random_state = 1234)\n",
        "\n",
        "strat_test['price_cat'].value_counts(normalize=True).sort_values()"
      ],
      "id": "b6aa6b39",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize = (9, 4))\n",
        "\n",
        "## Histograma en el training set\n",
        "sns.histplot(strat_train, x = \"price\", ax = ax1, bins = 18,\n",
        "             color = \"dodgerblue\", stat = \"density\")\n",
        "sns.kdeplot(strat_train[\"price\"], ax = ax1,\n",
        "            color = \"black\", linewidth = 2)\n",
        "ax1.set_title(\"Histograma del precio de vivienda\")\n",
        "ax1.set_xlabel(\"Precio ($)\")\n",
        "ax1.set_ylabel(\"Densidad\")\n",
        "\n",
        "## Histograma en el test set\n",
        "sns.histplot(strat_test, x = \"price\", ax = ax2, bins = 18,\n",
        "             color = \"dodgerblue\", stat = \"density\")\n",
        "sns.kdeplot(strat_test[\"price\"], ax = ax2,\n",
        "            color = \"black\", linewidth = 2)\n",
        "ax2.set_title(\"Histograma del precio de vivienda\")\n",
        "ax2.set_xlabel(\"Precio ($)\")\n",
        "ax2.set_ylabel(\"Densidad\")\n",
        "plt.show();"
      ],
      "id": "df02773e",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "for set_ in (strat_train, strat_test):\n",
        "    set_.drop(columns = 'price_cat', inplace = True)"
      ],
      "id": "ae432c52"
    }
  ],
